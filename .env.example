# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Grants full access (bypasses RLS). Used for seeding and for
# loading hidden test cases on the server.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. If set, POST /api/dev/seed requires a matching `x-seed-secret` header.
# SEED_SECRET=

# ---------------------------------------------------------------------------
# Judge0 (required for code execution - Phase 4)
# ---------------------------------------------------------------------------
# Judge0 CE base URL. Local dev can use Judge0 Cloud (RapidAPI) or self-hosted.
JUDGE0_BASE_URL=
# Optional: only needed for authenticated hosted Judge0 instances.
JUDGE0_API_KEY=

# ---------------------------------------------------------------------------
# OpenRouter (required for AI - Phase 10)
# ---------------------------------------------------------------------------
# SERVER ONLY. Never expose to the browser.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4